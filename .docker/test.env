# Docker only
PROJECT_NAME="italy-cookie-choices"
# Official WordPress images stop at 6.1 for PHP 7.4, used as PHP base
PHP_VERSION="7.4"
WP_VERSION="6.1"
# Latest WordPress that runs on PHP 7.4, downloaded over the image core
WP_CORE_VERSION="7.1.3"
SELENIUM_VERSION="4.25.0"

WP_PORT=8988
DB_PORT=8989
PMA_PORT=8990
SELENIUM_PORT=4444
VNC_PORT=7900

# Docker and Codeception
DB_NAME="test"
DB_HOST="mysql"
DB_USER="root"
DB_PASSWORD="root"

TABLE_PREFIX="wp_"

# Codeception configuration file, paths and hosts are the ones inside the wordpress container
WP_ROOT_FOLDER="/var/www/html"
WP_URL="http://wordpress"
WP_DOMAIN="wordpress"
ADMIN_EMAIL="admin@wordpress.test"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password"
# WPLoader drops and installs its tables, keep them apart from the e2e site
INTEGRATION_TABLE_PREFIX="int_"
SELENIUM_HOST="selenium"
