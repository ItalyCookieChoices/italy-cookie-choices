# Docker only
PROJECT_NAME="italy-cookie-choices"
# Official WordPress images stop at 6.1 for PHP 7.4
PHP_VERSION="7.4"
WP_VERSION="6.1"
SELENIUM_VERSION="4.25.0"

WP_PORT=8988
DB_PORT=8989
PMA_PORT=8990
SELENIUM_PORT=4444
VNC_PORT=7900

# Docker and Codeception
DB_NAME="test"
DB_HOST="mysql"
DB_USER="root"
DB_PASSWORD="root"

# Codeception configuration file
ROOT_FOLDER="../../../"
TABLE_PREFIX="wp_"
