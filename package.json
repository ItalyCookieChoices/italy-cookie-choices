    "@types/wordpress__blocks": "^15.10.2",
    "@wordpress/block-editor": "^12.19.9",
    "@wordpress/blocks": "^12.28.6",
    "@wordpress/element": "^5.28.1",
    "@wordpress/i18n": "^4.51.1",
