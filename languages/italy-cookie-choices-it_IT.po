#: src/Consent/UI/ConsentTexts.php:113
msgid "Necessary"
msgstr "Necessari"

#: src/Consent/UI/ConsentTexts.php:114
msgid "Needed for the site to work, like the cookie that stores this choice. Always active."
msgstr "Servono al funzionamento del sito, come il cookie che memorizza questa scelta. Sempre attivi."

#: src/Consent/UI/ConsentTexts.php:121
msgid "Remember your choices, like the language or the region."
msgstr "Ricordano le tue scelte, come la lingua o la regione."

