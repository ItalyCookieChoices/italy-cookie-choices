{
  "name": "italycookiechoices/italy-cookie-choices",
  "description": "The cookie choices plugin for cookie law",
  "keywords": ["WordPress", "cookie choices", "cookie law"],
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "overclokk",
      "email": "info@overclokk.net",
      "homepage": "https://www.italystrap.com",
      "role": "Developer"
    },
    {
      "name": "andreapernici",
      "email": "info@andreapernici.com",
      "role": "Developer"
    },
    {
      "name": "acardinale",
      "email": "info@andrea-cardinale.it",
      "role": "Developer"
    },
    {
      "name"    : "Contributors",
      "homepage": "https://github.com/ItalyCookieChoices/italy-cookie-choices/graphs/contributors"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=7.4",
    "overclokk/minimum-requirements": "dev-master",
    "overclokk/cookie": "^1.0",
    "italystrap/config": "^2.11"
  },
  "require-dev": {
    "lucatume/wp-browser": "^3.8",
    "lucatume/function-mocker-le": "^1.0",
    "lucatume/function-mocker": "^2.0",

    "codeception/c3": "^2.9",
    "codeception/module-asserts": "^1.3",
    "codeception/module-phpbrowser": "^1.0",
    "codeception/module-webdriver": "^1.4",
    "codeception/module-db": "^1.2",
    "codeception/module-filesystem": "^1.0",
    "codeception/module-cli": "^1.1",
    "codeception/util-universalframework": "^2.0",

    "brianium/paratest": "^6.11",
    "italystrap/debug": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpstan/phpstan": "^2.3",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "vimeo/psalm": "^5.26",

    "phpbench/phpbench": "^1.2",
    "infection/infection": "^0.26.6",

    "phpmetrics/phpmetrics": "^2.11",
    "phpspec/prophecy-phpunit": "^2.5",
    "rector/rector": "^2.7",
    "infection/codeception-adapter": "^0.4.1"
  },
  "autoload": {
    "psr-4": {
      "Italy_Cookie_Choices\\Admin\\": "legacy/admin/",
      "Italy_Cookie_Choices\\Core\\": "legacy/core/",
      "Italy_Cookie_Choices\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/"
    ],
    "psr-4": {
      "ItalyCookieChoices\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": [
      "@php vendor/bin/phpcs -p"
    ],
    "cs:fix": [
      "@php vendor/bin/phpcbf -p"
    ],
    "stan": [
      "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress"
    ],
    "stan:baseline": [
      "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress --generate-baseline phpstan-baseline.neon"
    ],
    "analyze": [
      "@stan",
      "@php vendor/bin/psalm"
    ],
    "integration": [
      "@php vendor/bin/codecept run integration",
      "@clean"
    ],
    "integration:debug": [
      "@php vendor/bin/codecept run integration --debug",
      "@clean"
    ],
    "e2e": [
      "@php vendor/bin/codecept run e2e",
      "@clean"
    ],
    "e2e:debug": [
      "@php vendor/bin/codecept run e2e --debug",
      "@clean"
    ],
    "tests": [
      "@php vendor/bin/codecept run integration",
      "@php vendor/bin/codecept run e2e",
      "@clean"
    ],
    "infection": [
      "@php vendor/bin/codecept run integration",
      "@php vendor/bin/infection --threads=1"
    ],
    "bench": [
      "@php vendor/bin/phpbench run --report=performance"
    ],
    "metrics": [
      "@php vendor/bin/phpmetrics --report-html=./tests/_output/report ./legacy/"
    ],
    "clean": [
      "@php vendor/bin/codecept clean"
    ]
  },
  "support"    : {
    "issues": "https://github.com/ItalyCookieChoices/italy-cookie-choices/issues",
    "source": "https://github.com/ItalyCookieChoices/italy-cookie-choices"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/package-versions-deprecated": true,
      "codeception/c3": true,
      "infection/extension-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  }
}
