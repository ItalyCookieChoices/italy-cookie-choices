parameters:
	ignoreErrors:
		-
			message: '#^Function icc_set_plugin_default_constant\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: legacy/define-constants.php

		-
			message: '#^Elseif condition is always true\.$#'
			identifier: elseif.alwaysTrue
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Function Italy_Cookie_Choices\\Core\\is_debug\(\) should return string but returns bool\.$#'
			identifier: return.type
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Function Italy_Cookie_Choices\\Core\\is_sitemaps_xml\(\) should return bool but empty return statement found\.$#'
			identifier: return.empty
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Function Italy_Cookie_Choices\\Core\\is_sitemaps_xml\(\) should return bool but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Function Italy_Cookie_Choices\\Core\\wp_json_encode\(\) should return bool\|string but returns mixed\.$#'
			identifier: return.type
			count: 2
			path: legacy/functions/general-functions.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Left side of \|\| is always true\.$#'
			identifier: booleanOr.leftAlwaysTrue
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$value$#'
			identifier: parameter.notFound
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Parameter \#1 \$haystack of function str_contains expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Parameter \#1 \$haystack of function stripos expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Parameter \#1 \$string of function strtolower expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Parameter \#1 \$string of function substr expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Parameter \#2 \$array of function implode expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: legacy/functions/general-functions.php

		-
			message: '#^Parameter \#1 \$text of function esc_attr expects string, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: legacy/init.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: uninstall.php

		-
			message: '#^Cannot access offset ''blog_id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: uninstall.php

		-
			message: '#^Cannot access property \$blogs on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: uninstall.php

		-
			message: '#^Cannot call method get_results\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: uninstall.php

		-
			message: '#^Parameter \#1 \$new_blog_id of function switch_to_blog expects int, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: uninstall.php

		-
			message: '#^Part \$wpdb\-\>blogs \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: uninstall.php

