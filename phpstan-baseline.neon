parameters:
	ignoreErrors:
		-
			message: '#^Function icc_set_plugin_default_constant\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: legacy/define-constants.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: uninstall.php

		-
			message: '#^Cannot access offset ''blog_id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: uninstall.php

		-
			message: '#^Cannot access property \$blogs on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: uninstall.php

		-
			message: '#^Cannot call method get_results\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: uninstall.php

		-
			message: '#^Parameter \#1 \$new_blog_id of function switch_to_blog expects int, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: uninstall.php

		-
			message: '#^Part \$wpdb\-\>blogs \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: uninstall.php

