includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - italy-cookie-choices.php
        - bootstrap.php
        - uninstall.php
        - src
        - legacy
        - tests
    bootstrapFiles:
        - tests/_support/phpstan-bootstrap.php
    scanFiles:
        - tests/_support/stubs/multilingual.php
        - tests/_support/stubs/multilingualpress.php
        - tests/_support/stubs/wp-cli.php
    scanDirectories:
        # WordPress core test classes, like the factories, used by WPTestCase
        - vendor/lucatume/wp-browser/includes/core-phpunit/includes
    excludePaths:
        analyse:
            - tests/_data/*
            - tests/_output/*
            - tests/_support/_generated/*
    parallel:
        maximumNumberOfProcesses: 1
